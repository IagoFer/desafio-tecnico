APP_NAME="Desafio Devlith"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# ==========================================
# Banco de Dados
# ==========================================
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=root
DB_PASSWORD=rootpass

# Porta exposta para a máquina local via Docker
KOOL_DATABASE_PORT=3307

# ==========================================
# Infraestrutura (Redis)
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Porta exposta para a máquina local via Docker
KOOL_REDIS_PORT=6379

# ==========================================
# Serviços do Laravel (Cache, Queue, Sessão)
# ==========================================
CACHE_STORE=redis

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# Outros Serviços
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Vite / Frontend
VITE_APP_NAME="${APP_NAME}"
